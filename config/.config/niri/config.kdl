// niri config — ported from Hyprland muscle memory + look
// Docs: https://niri-wm.github.io/niri/Configuration%3A-Introduction.html
// opacity.kdl + gamemode.kdl are included at the end so they win.

hotkey-overlay {
    skip-at-startup
}

input {
    keyboard {
        xkb {
            layout "us"
            options "caps:swapescape"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
        click-method "clickfinger"
    }

    mouse {
        accel-speed 0.4
    }

    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="10%"
    disable-power-key-handling
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "kde"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    GDK_SCALE "1"
    MOZ_ENABLE_WAYLAND "1"
    XCURSOR_THEME "Bibata-Modern-Classic"
    XCURSOR_SIZE "24"
    APPIMAGELAUNCHER_DISABLE "1"
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    OZONE_PLATFORM "wayland"
}

// eDP-1 mode lives in output-edp.kdl (rewritten by refresh-rate.sh)
include "output-edp.kdl"

output "HDMI-A-1" {
    mode "1920x1080@60.000"
    scale 1
    position x=1920 y=0
}

layout {
    gaps 5

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        width 2
        active-gradient from="#30100E" to="#865042" angle=45
        inactive-color "#07050Aaa"
    }

    struts {
        // leave room for waybar if needed
    }
}

overview {
    backdrop-color "#07050A"
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    // slowdown 1.0
}

// Background blur (seen through window opacity < 1). xray blurs wallpaper — cheap.
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.2
}

// --- autostart ---
spawn-at-startup "waybar" "-c" "/home/narayan/.config/waybar/config-niri" "-s" "/home/narayan/.config/waybar/style.css"
spawn-at-startup "awww-daemon"
// OpenRGB SDK server: keeps MSI keyboard ready for smooth wallpaper fades
spawn-at-startup "openrgb" "--server" "--noautoconnect"
spawn-sh-at-startup "sleep 2; /home/narayan/.config/scripts/sync-keyboard-rgb.sh"
spawn-at-startup "dunst"
spawn-at-startup "/home/narayan/.config/scripts/niri-idle.sh"
spawn-at-startup "clipse" "-listen"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-at-startup "eww" "daemon"
spawn-sh-at-startup "eww open clock"
spawn-at-startup "xwayland-satellite"

// --- window rules ---
// Opacity lives in opacity.kdl (included last) so Super+O / gamemode can override it.
window-rule {
    draw-border-with-background false
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id="clipse"
    open-floating true
    default-column-width { fixed 622; }
    default-window-height { fixed 652; }
}

window-rule {
    match app-id="com.saivert.pwvucontrol"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id=r#"^[sS]potify$"#
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id=r#"(firefox|LibreWolf|zen|zen-browser)$"# title="^Picture-in-Picture$"
    open-floating true
    default-floating-position x=32 y=32 relative-to="top-right"
}

window-rule {
    match is-window-cast-target=true
    border {
        active-color "#f38ba8"
        inactive-color "#7d0d2d"
    }
}

window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screen-capture"
}

// --- binds (Hyprland muscle memory) ---
binds {
    // Apps
    Mod+Return { spawn "wezterm"; }
    Mod+Q { close-window; }
    Mod+A { spawn "pwvucontrol"; }
    Mod+E { spawn-sh "~/.config/ml4w/settings/filemanager.sh"; }
    Mod+B { spawn-sh "~/.config/ml4w/settings/browser.sh"; }
    Mod+W { spawn-sh "$HOME/.config/scripts/wallpaper-picker.sh"; }
    Mod+T { toggle-window-floating; }
    Mod+F { fullscreen-window; }
    Mod+Ctrl+Return { spawn "/home/narayan/.config/rofi/launchers/type-6/launcher.sh"; }
    Mod+Shift+V { spawn-sh "wezterm start --class clipse -- clipse"; } 
    Mod+Shift+S { spawn "spotify"; }
    Mod+Shift+L { spawn "swaylock"; }
    Mod+R { spawn-sh "$HOME/.config/scripts/wf-recorder.sh"; }
    Mod+Shift+R { spawn-sh "$HOME/.config/scripts/refresh-rate.sh"; }
    Mod+F1 { spawn-sh "$HOME/.config/scripts/gamemode.sh"; }
    Mod+Shift+B { spawn-sh "killall -SIGUSR2 waybar"; }
    Mod+Ctrl+B { spawn-sh "pkill waybar || waybar -c $HOME/.config/waybar/config-niri -s $HOME/.config/waybar/style.css"; }
    Mod+Ctrl+C { spawn-sh "$HOME/.config/eww/scripts/toggle-clock.sh"; }
    Mod+M { quit; }

    // Media
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.4" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "$HOME/.config/scripts/brightness-notify.sh up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "$HOME/.config/scripts/brightness-notify.sh down"; }

    // Focus
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    // Move windows within strip
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+L { move-column-right; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }

    // Workspaces (Hypr: Super+N focus, Super+Shift+N move)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Shift+0 { move-window-to-workspace 10; }

    // Monitors (Hypr: Super+Shift+Left/Right moved workspace)
    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-workspace-to-monitor-right; }

    // Screenshots (Hypr: Print / Super+Print / Shift+Print)
    Print { screenshot-screen; }
    Mod+Print { screenshot-window; }
    Shift+Print { screenshot; }

    // Niri-native extras (no Hypr clash)
    Mod+Tab { toggle-overview; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+O { spawn-sh "$HOME/.config/scripts/opacity-toggle.sh"; }
    Mod+P { switch-preset-column-width; }
    Mod+Shift+F { maximize-column; }
    Mod+C { center-column; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+P { power-off-monitors; }
}

// Dynamic toggles — must be last so window-rule opacity / animations win
include "opacity.kdl"
include "gamemode.kdl"

